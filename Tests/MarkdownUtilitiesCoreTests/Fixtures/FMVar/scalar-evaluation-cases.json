{
  "version": "1.0.0",
  "cases": [
    {
      "name": "zero fallback",
      "yaml": "other: 1",
      "markdown": "<fm-var query=\"$.v\" default-zero=\"none\" default-null=\"null\">old</fm-var>",
      "status": "zero-result-fallback",
      "expected": "none",
      "codes": [],
      "count": 0
    },
    {
      "name": "null fallback",
      "yaml": "v: null",
      "markdown": "<fm-var query=\"$.v\" default-zero=\"none\" default-null=\"null\">old</fm-var>",
      "status": "null-result-fallback",
      "expected": "null",
      "codes": [],
      "count": 1
    },
    {
      "name": "zero cannot use null fallback",
      "yaml": "other: 1",
      "markdown": "<fm-var query=\"$.v\" default-null=\"null\">old</fm-var>",
      "status": "unresolved-zero-result",
      "expected": null,
      "codes": [
        "fm-var.value.unresolved-zero-result"
      ],
      "count": 0
    },
    {
      "name": "null cannot use zero fallback",
      "yaml": "v: null",
      "markdown": "<fm-var query=\"$.v\" default-zero=\"none\">old</fm-var>",
      "status": "unresolved-null-result",
      "expected": null,
      "codes": [
        "fm-var.value.unresolved-null-result"
      ],
      "count": 1
    },
    {
      "name": "empty fallback is present",
      "yaml": "other: 1",
      "markdown": "<fm-var query=\"$.v\" default-zero=\"\">old</fm-var>",
      "status": "zero-result-fallback",
      "expected": "",
      "codes": [],
      "count": 0
    },
    {
      "name": "fresh fallback retains status",
      "yaml": "v: null",
      "markdown": "<fm-var query=\"$.v\" default-null=\"old\">old</fm-var>",
      "status": "null-result-fallback",
      "expected": "old",
      "codes": [],
      "count": 1
    },
    {
      "name": "empty",
      "yaml": "v: \"\"",
      "markdown": "<fm-var query=\"$.v\" default-zero=\"fallback\" default-null=\"fallback\">old</fm-var>",
      "status": "stale",
      "expected": "",
      "codes": [],
      "count": 1
    },
    {
      "name": "zero",
      "yaml": "v: 0",
      "markdown": "<fm-var query=\"$.v\" type=\"integer\" default-zero=\"fallback\" default-null=\"fallback\">old</fm-var>",
      "status": "stale",
      "expected": "0",
      "codes": [],
      "count": 1
    },
    {
      "name": "false",
      "yaml": "v: false",
      "markdown": "<fm-var query=\"$.v\" type=\"boolean\" default-zero=\"fallback\" default-null=\"fallback\">old</fm-var>",
      "status": "stale",
      "expected": "FALSE",
      "codes": [],
      "count": 1
    },
    {
      "name": "fallback bypasses type and format",
      "yaml": "v: null",
      "markdown": "<fm-var query=\"$.v\" type=\"integer\" format=\"custom\" default-null=\"not an integer\">old</fm-var>",
      "status": "null-result-fallback",
      "expected": "not an integer",
      "codes": [],
      "count": 1
    },
    {
      "name": "fallback entities decode once",
      "yaml": "other: 1",
      "markdown": "<fm-var query=\"$.v\" default-zero=\"&amp;lt;&lt;b&gt;&#42;\">old</fm-var>",
      "status": "zero-result-fallback",
      "expected": "&amp;lt;&lt;b&gt;&#42;",
      "codes": [],
      "count": 0
    },
    {
      "name": "closing tag and delimiters",
      "yaml": "v: '</fm-var><script>&amp; \\`*_~[]| Café 😀'",
      "markdown": "<fm-var query=\"$.v\">old</fm-var>",
      "status": "stale",
      "expected": "&lt;/fm-var&gt;&lt;script&gt;&amp;amp; &#92;&#96;&#42;&#95;&#126;&#91;&#93;&#124; Café 😀",
      "codes": [],
      "count": 1
    },
    {
      "name": "numeric entity spelling becomes canonical",
      "yaml": "v: '*'",
      "markdown": "<fm-var query=\"$.v\">&#x2A;</fm-var>",
      "status": "stale",
      "expected": "&#42;",
      "codes": [],
      "count": 1
    },
    {
      "name": "byte distinct unicode",
      "yaml": "v: 'é'",
      "markdown": "<fm-var query=\"$.v\">é</fm-var>",
      "status": "stale",
      "expected": "é",
      "codes": [],
      "count": 1
    },
    {
      "name": "fresh unicode",
      "yaml": "v: 'é'",
      "markdown": "<fm-var query=\"$.v\">é</fm-var>",
      "status": "valid",
      "expected": "é",
      "codes": [],
      "count": 1
