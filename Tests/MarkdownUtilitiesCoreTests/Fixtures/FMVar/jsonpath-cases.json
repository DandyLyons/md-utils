{
  "version": "1.0.0",
  "cases": [
    {
      "name": "child selectors",
      "query": "$.store.book[0].title",
      "expected-node-ids": ["$['store']['book'][0]['title']"]
    },
    {
      "name": "descendant selectors",
      "query": "$..author",
      "expected-node-ids": [
        "$['store']['book'][0]['author']",
        "$['store']['book'][1]['author']",
        "$['store']['book'][2]['author']"
      ]
    },
    {
      "name": "wildcard selectors preserve array order",
      "query": "$.store.book[*].title",
      "expected-node-ids": [
        "$['store']['book'][0]['title']",
        "$['store']['book'][1]['title']",
        "$['store']['book'][2]['title']"
      ]
    },
    {
      "name": "negative index selector",
      "query": "$.store.book[-1].title",
      "expected-node-ids": ["$['store']['book'][2]['title']"]
    },
    {
      "name": "slice selector",
      "query": "$.store.book[1:3].title",
      "expected-node-ids": [
        "$['store']['book'][1]['title']",
        "$['store']['book'][2]['title']"
      ]
    },
    {
      "name": "union preserves duplicates",
      "query": "$.store.book[2,0,2].title",
      "expected-node-ids": [
        "$['store']['book'][2]['title']",
        "$['store']['book'][0]['title']",
        "$['store']['book'][2]['title']"
      ]
    },
    {
      "name": "filter selector",
      "query": "$.store.book[?@.price < 10].title",
      "expected-node-ids": [
        "$['store']['book'][0]['title']",
        "$['store']['book'][2]['title']"
      ]
    },
    {
      "name": "unicode and quoted member names",
      "query": "$['métadata']['a.b[c]']",
      "expected-node-ids": ["$['métadata']['a.b[c]']"]
    },
    {
      "name": "structural mismatch is empty",
      "query": "$.store.book[0].title[0]",
      "expected-node-ids": []
    }
  ]
}
