{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://dandylyons.github.io/md-utils/schemas/mdtype/2/wikilink-constraints/mdtype.schema.json",
  "$comment": "mdtype v2 asserts semantic string formats using the md-utils evaluation profile. Generic JSON Schema consumers may treat format as annotation.",
  "title": "md-utils Markdown Type Definition",
  "type": "object",
  "required": ["md-utils-type-schema", "name", "version", "frontmatter", "body", "context"],
  "properties": {
    "md-utils-type-schema": { "const": "2" },
    "requires": { "type": "array", "uniqueItems": true, "items": { "enum": ["wikilink-constraints"] } },
    "name": { "type": "string", "minLength": 1 },
    "version": { "type": "string", "minLength": 1 },
    "frontmatter": { "$ref": "#/$defs/frontmatter" },
    "body": { "$ref": "#/$defs/constraintGroup" },
    "context": { "$ref": "#/$defs/constraintGroup" },
    "creation": {
      "type": "object", "required": ["template"], "additionalProperties": false,
      "properties": {
        "template": {
          "type": "object", "additionalProperties": false,
          "oneOf": [{"required": ["inline"]}, {"required": ["ref"]}],
          "properties": {
            "inline": {"type": "string"},
            "ref": {"type": "string", "minLength": 1},
            "mode": {"enum": ["document", "body"], "default": "document"},
            "inputSchema": {
              "type": "object", "additionalProperties": false,
              "oneOf": [{"required": ["inline"]}, {"required": ["ref"]}],
              "properties": {
                "inline": {"type": ["object", "boolean"]},
                "ref": {"type": "string", "minLength": 1}
              }
            }
          }
        }
      }
    }
  },
  "additionalProperties": false,
  "$defs": {
    "wikilinkPolicy": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "styles": { "type": "array", "minItems": 1, "uniqueItems": true, "items": { "enum": ["name", "vault-path", "relative-path", "self-anchor"] } },
        "markdownExtension": { "enum": ["require", "omit", "either"], "default": "either" }
      },
      "not": { "required": ["styles", "markdownExtension"], "properties": { "styles": { "const": ["self-anchor"] }, "markdownExtension": { "const": "require" } } },
      "$comment": "Runtime validates policy nodes throughout loaded schema locations, their sibling type/format declarations, and the required capability gate. This definition is reusable by tooling."
    },
    "frontmatter": {
      "type": "object",
      "properties": {
        "presence": { "enum": ["required", "optional"] },
        "recommendedSchemas": { "$ref": "#/$defs/frontmatter/properties/schemas" },
        "schemas": {
          "type": "array",
          "items": {
            "oneOf": [
              {
                "type": "object",
                "required": ["ref"],
                "properties": { "ref": { "type": "string", "minLength": 1 } },
                "additionalProperties": false
              },
              {
                "type": "object",
                "required": ["inline"],
                "properties": { "inline": { "type": "object" } },
                "additionalProperties": false
              }
            ]
          }
        }
      },
      "additionalProperties": false
    },
    "constraintGroup": {
      "type": "object",
      "required": ["requirements", "recommendations"],
      "properties": {
        "requirements": { "type": "array", "items": { "$ref": "#/$defs/constraint" } },
        "recommendations": { "type": "array", "items": { "$ref": "#/$defs/constraint" } }
      },
      "additionalProperties": false
    },
    "heading": {
      "type": "object",
      "required": ["text"],
      "properties": {
        "text": { "type": "string", "minLength": 1 },
        "level": { "type": "integer", "minimum": 1, "maximum": 6 }
      },
      "additionalProperties": false
    },
    "constraint": {
      "type": "object",
      "required": ["id"],
      "properties": {
        "id": { "type": "string", "minLength": 1 },
        "heading": { "$ref": "#/$defs/heading" },
        "headingRelationship": {
          "type": "object",
          "required": ["parent", "child", "relationship"],
          "properties": {
            "parent": { "$ref": "#/$defs/heading" },
            "child": { "$ref": "#/$defs/heading" },
            "relationship": { "enum": ["directChild", "descendant"] }
          },
          "additionalProperties": false
        },
        "section": {
          "type": "object",
          "required": ["heading"],
          "properties": {
            "heading": { "$ref": "#/$defs/heading" },
            "content": { "enum": ["any", "nonEmpty"] }
          },
          "additionalProperties": false
        },
        "path": {
          "type": "object",
          "required": ["glob"],
          "properties": { "glob": { "type": "string", "minLength": 1 } },
          "additionalProperties": false
        },
        "maxBodyLines": { "type": "integer", "minimum": 0 },
        "maxBodyWords": { "type": "integer", "minimum": 0 }
      },
      "minProperties": 2,
      "maxProperties": 2,
      "additionalProperties": false
    }
  }
}
